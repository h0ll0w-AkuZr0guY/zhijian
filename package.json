{
  "name": "zhijian",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "纸间 · 本地优先的 A4 文档、简历与 PDF 编辑器",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit && eslint src tests && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fonteditor-core": "^2.6.3",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.10.38",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tesseract.js": "^6.0.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
