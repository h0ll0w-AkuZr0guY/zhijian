{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "纸间",
  "version": "1.0.0",
  "identifier": "app.zhijian.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "纸间 · 自由文档工作台",
        "width": 1500,
        "height": 960,
        "minWidth": 1000,
        "minHeight": 700
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "languages": ["SimpChinese", "English"], "displayLanguageSelector": true }
    }
  }
}
